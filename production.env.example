# Production Environment Variables for Fantasma Firewall
# Copy this file to .env and update the values

# Application Environment
NODE_ENV=production
PORT=3000

# Database Configuration
# Replace with your actual PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/fantasma_firewall

# Security
# Generate a secure session secret: openssl rand -base64 64
SESSION_SECRET=your-super-secure-session-secret-here

# Performance Optimization
NODE_OPTIONS="--max-old-space-size=4096"

# Optional: External Database (if not using local PostgreSQL)
# DATABASE_URL=postgresql://user:pass@your-db-host:5432/dbname

# Optional: Redis (if using external cache)
# REDIS_URL=redis://localhost:6379

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn-here
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ZED AI integration + VPN/domain exposure
# Public HTTPS URL you will put on your domain, for example: https://firewall.yourdomain.com
ZETA_PUBLIC_BASE_URL=https://firewall.yourdomain.com
# Private VPN URL ZedAI can use over WireGuard/Tailscale/OpenVPN, for example: http://100.96.10.12:5000
ZETA_VPN_BASE_URL=
# Label used in admin UI and docs, for example: Tailscale
ZETA_VPN_PROVIDER=
# Shared token that ZedAI sends when polling the firewall integration endpoint
ZETA_SHARED_TOKEN=replace-with-long-random-token

# Optional: Email notifications (for alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: Backup configuration
# BACKUP_RETENTION_DAYS=7
# BACKUP_S3_BUCKET=your-backup-bucket

# Security Headers (optional overrides)
# CORS_ORIGIN=https://yourdomain.com
# TRUST_PROXY=true
