NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/fantasma_firewall
NODE_OPTIONS="--max-old-space-size=4096"

ZCOS_TRUSTED_GATEWAY_SECRET=replace-with-a-long-random-secret
ZCOS_GRANT_SIGNING_SECRET=replace-with-a-separate-long-random-secret
ZCOS_APPROVAL_SIGNING_SECRET=replace-with-another-long-random-secret
ZCOS_CAPABILITY_SIGNING_SECRET=replace-with-a-capability-registry-signing-secret
ZCOS_ISOLATION_SIGNING_SECRET=replace-with-an-execution-runtime-signing-secret

ZENA_INTEGRATION_TOKEN=replace-with-a-long-random-secret
ZENA_INTEGRATION_OWNER_ID=replace-with-canonical-owner-id
ZENA_INTEGRATION_ACTOR_ID=zcos-integration-service

# Inject real values from a secret manager. Never commit populated credentials.
# TRUST_PROXY=true
